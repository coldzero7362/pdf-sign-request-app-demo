# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# DB (공용 MariaDB의 docsign 스키마)
DB_HOST=db
DB_PORT=3306
DB_NAME=docsign
DB_USER=docsign
DB_PASSWORD=

# 서비스 주소 (메일 링크, OAuth 리디렉션에 사용)
APP_BASE_URL=https://pdfsign.158-247-240-171.sslip.io

# Google OAuth (Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID, 웹 애플리케이션)
# 승인된 리디렉션 URI: ${APP_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 다음 단계에서 사용 (Gmail SMTP 앱 비밀번호)
# MAIL_USERNAME=
# MAIL_APP_PASSWORD=
